# Relay origin (shared name with apps/viewer's .env.example)
VITE_RELAY_ORIGIN=http://localhost:8787

# Optional: a link to an active demo room, shown as "watch a live session now"
VITE_DEMO_SESSION_URL=

# Optional: the recorded demo clip and its poster frame
VITE_DEMO_VIDEO_URL=/demo.mp4
VITE_DEMO_POSTER_URL=/demo-poster.png
