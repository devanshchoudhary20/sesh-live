{
  "name": "sesh-live",
  "version": "0.1.0",
  "type": "module",
  "description": "PTY wrapper that streams an agent CLI session (Claude Code, Codex) to a relay so someone else can watch it live in a browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devanshchoudhary20/sesh-live.git"
  },
  "homepage": "https://github.com/devanshchoudhary20/sesh-live",
  "keywords": [
    "cli",
    "terminal",
    "pty",
    "agent",
    "claude-code",
    "codex",
    "pair-programming",
    "live-stream"
  ],
  "bin": {
    "sesh-live": "./index.js"
  },
  "files": [
    "index.js",
    "lib.js",
    "config.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');try{const dir=path.dirname(require.resolve('node-pty/package.json'));const helper=path.join(dir,'prebuilds','darwin-arm64','spawn-helper');if(fs.existsSync(helper))fs.chmodSync(helper,0o755)}catch{}\""
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
